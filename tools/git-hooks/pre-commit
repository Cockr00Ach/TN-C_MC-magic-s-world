#!/bin/sh
# TN-C pre-commit hook - blocks large / third-party files from being committed.
#
#   Installed automatically for anyone who runs:
#       git config core.hooksPath tools/git-hooks
#   (that setting is per-clone; see README.md "版本控制" section)
#
#   The actual checks live in tools/check-staged.ps1 so they can also be run
#   by hand. This shim exists because git runs hooks with the bundled MSYS sh.
#
#   Bypass (only if you are certain):  git commit --no-verify

here=$(cd "$(dirname "$0")" && pwd)

if command -v powershell >/dev/null 2>&1; then
    # Capture first, then print: piping PowerShell straight into git makes git
    # wrap every line in "System.Management.Automation.RemoteException", which
    # looks like the hook itself is broken. ASCII-only output, so no encoding risk.
    out=$(powershell -NoProfile -ExecutionPolicy Bypass -File "$here/../check-staged.ps1" 2>&1)
    status=$?
    printf '%s\n' "$out"
    exit $status
else
    echo "pre-commit: powershell not found - skipping the staged-file check" >&2
    exit 0
fi
