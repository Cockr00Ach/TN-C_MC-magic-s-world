          "count": 1,
          "consume_items": false
        }
      ],
      "rewards": []
    },
    {
      "id": "4E72F46453B6285B",
      "title": "&a史莱姆蹦床",
      "icon": "tnc:mana_pressure_tread",
      "x": -4,
      "y": 3,
      "description": [
        "在拘束笼下铺魔力压电踏板，史莱姆每次实际落地制造20土魔力。",
        "拿糖右键笼子增加高跳次数。由踏板输出到晶纤，注意同时给笼子供魔。"
      ],
