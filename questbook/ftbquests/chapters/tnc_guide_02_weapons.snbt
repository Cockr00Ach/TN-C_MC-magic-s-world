  "quests": [
    {
      "id": "544E430202000000",
      "title": "&b&l法杖与匠人",
      "icon": "minecraft:stick",
      "x": 0.0,
      "y": 0.0,
      "size": 1.8,
      "shape": "circle",
      "description": [
        "&b&l法杖与匠人",
        "&7知识属于你，法器承载力量",
        "",
        "&e分级武器与匠人订单筹备中",
        "",
        "&f点击章节中的节点阅读说明。勾选只表示看过本节，不代表完成升级、买房或委托。",
        "&7本批先搭任务书框架；筹备中的行为目标与奖励将在机制实装后开放。"
      ],
      "tasks": [
        {
          "id": "544E430302000000",
          "type": "checkmark",
          "title": "阅读本节（不发放玩法奖励）"
        }
      ],
      "rewards": [],
      "dependencies": []
    },
    {
      "id": "544E430202000001",
      "title": "五档法器",
      "icon": "minecraft:stick",
      "x": -3.0,
      "y": 3.0,
      "size": 1.0,
      "shape": "circle",
      "description": [
        "&e分级武器与匠人订单筹备中",
        "",
        "&b&l五档法器",
        "",
        "&f水·冒险者法阵 → 水·精良法杖 → 水·王级法杖 → 水·传说级法杖 → 傲慢的水龙王。",
        "&f精良是武器品级；勇者级是法术等级；王级冒险者是协会职称。三套体系不同，拿到神杖也不会凭空学会神法。"
      ],
      "tasks": [
        {
          "id": "544E430302000001",
          "type": "checkmark",
          "title": "阅读本节（不发放玩法奖励）"
        }
      ],
      "rewards": [],
      "dependencies": []
    },
    {
      "id": "544E430202000002",
      "title": "把材料带给匠人",
      "icon": "minecraft:stick",
      "x": 3.0,
      "y": 3.0,
      "size": 1.0,
      "shape": "circle",
      "description": [
        "&e分级武器与匠人订单筹备中",
        "",
        "&b&l把材料带给匠人",
        "",
        "&f计划由匠人打造职业战斗装备：你寻找矿石、晶体和战利品，提交材料与人工费，匠人完成订单。第一件教学法器免人工费。",
        "&f具体配方后续定稿。本页图标是装备概念展示，不是已经注册的新物品，也不要求你寻找不存在的配方。"
      ],
      "tasks": [
        {
          "id": "544E430302000002",
          "type": "checkmark",
          "title": "阅读本节（不发放玩法奖励）"
        }
      ],
      "rewards": [],
      "dependencies": []
    },
    {
      "id": "544E430202000003",
      "title": "自己建设生活",
      "icon": "minecraft:stick",
      "x": -3.0,
      "y": 6.0,
      "size": 1.0,
      "shape": "circle",
      "description": [
        "&e分级武器与匠人订单筹备中",
        "",
        "&b&l自己建设生活",
        "",
        "&f农具、工作台、灶具和建筑部件仍可自己制作；取消自行打造的范围先是本包法杖和后续职业战斗装备，不删除全包配方。",
        "&f战士路线后续设计。本批不更换现有施法法杖，不改变已学法术。"
      ],
      "tasks": [
        {
          "id": "544E430302000003",
          "type": "checkmark",
          "title": "阅读本节（不发放玩法奖励）"
        }
      ],
