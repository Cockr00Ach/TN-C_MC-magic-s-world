  "quests": [
    {
      "id": "4DCB211B93C79E8D",
      "title": "云上初见",
      "icon": "minecraft:flowering_azalea",
      "x": 0.0,
      "y": 0.0,
      "size": 1.6,
      "description": [
        "新建世界从独立云溪界的天空岛抵达花坡开始。外出冒险时使用岛上原有传送门前往主世界；主世界对应传送门可返回。岛下玄潮魔海与农田使用的流动魔力不同。",
        "抵达天空岛后观看可跳过的短镜头。随后自由逛镇，向Self和艾琳了解服务。电影播放不能替代初次命名。",
        "使用 /skylesson 查看下一站导师与实时坐标。右键导师可以重听；跳过动画不会自动完成实操。",
        "每人独立保存进度；镜湖本轮仅建设景观，尚未加入钓鱼系统。"
      ],
      "dependencies": [],
      "tasks": [
        {
          "id": "2E6FD87FC1DB5BC3",
          "type": "advancement",
          "advancement": "tnc:onboarding/academy_arrival"
        }
