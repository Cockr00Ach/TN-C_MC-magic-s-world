  "quests": [
    {
      "id": "4ECCE29F8CF445F9",
      "title": "&b&l魔脉迷宫 · 两个视界的探险",
      "icon": "tnc:dungeon_handbook",
      "x": 0,
      "y": -4,
      "description": [
        "战斗房清场开门，奇遇房可先离开再回来，解谜成功才领取奖励。每5层保存，保留原有倒地与救援规则。",
        "F8用于辨认供魔动脉、机关线索和隐藏实体。谜题进度由服务器保存；不要求一进门就带齐所有工具。",
        "下面四列是各领域的代表房型。少量桥梁、宝库、乐音和典当奇遇会跨区域出现。",
        "1—5层学习本领域基本语言，6层起加入工程与药学机关，11层起出现高风险交易和供魔挑战。",
        "房间任务通过实际解开机关完成。背包满时奖励进入地下城邮件，腾出格子后自动重试，重连也能领取。"
      ],
      "dependencies": [],
      "hide_dependency_lines": false,
      "tasks": [
        {
          "id": "4E8B5C39B0EE2267",
          "type": "checkmark"
        }
      ]
    },
    {
      "id": "2C5961BA43FE0847",
      "title": "&e&l黄沙遗庭",
      "icon": "tnc:dungeon_handbook",
      "x": -9.0,
      "y": -1,
      "description": [
        "光、影、干涸与古代机关",
        "对应不同的机关与怪物组合。主线通路、支线奖励分开，不会因缺少药水或工具卡死整层。"
      ],
      "dependencies": [
        "4ECCE29F8CF445F9"
