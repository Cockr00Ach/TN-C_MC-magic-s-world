          "advancement": "tnc:leyline/sundial"
        }
      ]
    },
    {
      "id": "31D54E05107E46EE",
      "title": "饥饿魔藤",
      "icon": "tnc:flowing_mana_bucket",
      "x": -9.0,
      "y": 4,
      "description": [
        "往石盆投入真实储有100M的魔力瓶，或一桶流动魔力，喂饱魔藤后通路打开，奖励可带回家的魔植种子。",
        "需要补给时可退出这间奇遇，继续探索其他门。"
      ],
      "dependencies": [
        "2C5961BA43FE0847"
      ],
      "hide_dependency_lines": true,
