  "quests": [
    {
      "id": "556D3E34DC594E0A",
      "title": "&3&l让庭院的魔力流动",
      "icon": "tnc:mana_workshop_book",
      "x": 0,
      "y": -9,
      "size": 2,
      "description": [
        "植物/动物→收集器→线路→储池→工作装置。全程纯魔力、真实余额。",
        "土中的流动魔力仅灌溉，不再回抽为能源。区块未加载就暂停；不补算离线产能。"
      ],
      "tasks": [
        {
          "id": "535A1677B65BFA2F",
          "type": "checkmark"
        }
      ],
      "dependencies": [],
      "rewards": [
